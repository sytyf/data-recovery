# ==================== Web 服务 ====================
# 监听地址：内网部署通常使用 0.0.0.0，单机调试可使用 127.0.0.1。
HOST=0.0.0.0
# Web 服务端口，浏览器访问地址为 http://<服务器地址>:PORT/。
PORT=3001
# 是否真实执行 Hive/HDFS 操作：1=真实执行，其他值或空值=仅 dry-run 模拟。
RECOVERY_EXECUTE=1

# ==================== 恢复源和本地目录 ====================
# 脱敏分区表源根目录。目录格式：根目录/YYYY-MM-DD/表名/PARTITION_COLUMN=YYYY-MM-DD/。
RECOVERY_MASKED_SOURCE_ROOT=/data/recovery/source/masked
# 未脱敏分区表源根目录，页面选择“未脱敏数据恢复”时使用。
RECOVERY_UNMASKED_SOURCE_ROOT=/data/recovery/source/unmasked
# 非分区表源根目录，目录格式：根目录/表名/，单日期恢复时使用。
RECOVERY_NON_PARTITION_SOURCE_ROOT=/data/recovery/source/non-partition
# 连续时间段恢复的本地中转根目录，恢复每张表前会清理该表对应子目录。
RECOVERY_STAGE_ROOT=/data/recovery/stage
# 数据文件打包的本地输出根目录，后端通过 hdfs dfs -get 写入。
DATA_PACKAGE_ROOT=/data/recovery/package

# ==================== 临时文件和任务清理 ====================
# 上传清单解析完成后会立即删除；该配置用于清理服务异常中断后残留的上传文件。
UPLOAD_FILE_RETENTION_HOURS=1
# generated 目录中配置、SQL、文本等中间文件的保留小时数。
TEMP_FILE_RETENTION_HOURS=24
# 可下载的数据量统计和视图源表 Excel 结果保留小时数，默认 7 天。
RESULT_FILE_RETENTION_HOURS=168
# 已结束任务在后端内存中的保留小时数，应与结果文件保留时间保持一致。
JOB_RETENTION_HOURS=168
# 后端扫描并清理过期文件的间隔分钟数。
TEMP_CLEANUP_INTERVAL_MINUTES=30

# ==================== 恢复执行策略 ====================
# 不同目标表之间的并发数；同一目标表仍按顺序执行。建议从 2 开始调整。
RECOVERY_TABLE_CONCURRENCY=2
# 分区元数据修复模式：add=只补充本次分区，msck=执行全表 MSCK REPAIR。
PARTITION_REPAIR_MODE=add
# HDFS put 遇到可重试异常时的最大重试次数。
HDFS_PUT_RETRY_COUNT=3

# ==================== Hive 和 Kerberos 连接 ====================
# HiveServer2 地址，不包含端口；后端默认连接 10000 端口。
INCP_IP=127.0.0.1
# Hive 登录用户名。
INCP_USER=your_hive_user
# Hive 密码，可为空；如使用 Kerberos，通常不需要填写。
INCP_PASSWD=
# Kerberos keytab 文件路径，运行后端的系统用户必须可读。
KRB_KEYTAB=/home/tyf/etc/ekg.keytab
# Kerberos principal。
KRB_PRINCIPAL=ekg@TDH

# ==================== 表和分区配置 ====================
# 日期分区字段名；本地目录、HDFS 路径、Hive 修复和数据量查询统一使用该字段。
PARTITION_COLUMN=tx_dt
# 跨库恢复默认源库；页面输入源库时优先使用页面输入。
SOURCE_DATABASE=prodb_dm
# system.tables_v 中保存 HDFS 表路径的字段名。
TABLE_LOCATION_COLUMN=table_location
# 跨库恢复不同目标表之间的并发数，同一目标表仍串行执行。
CROSS_TABLE_CONCURRENCY=2
# 跨库分区元数据修复模式：add=只补充本次分区，msck=执行全表修复。
CROSS_REPAIR_MODE=add

# ==================== 批量查询性能 ====================
# 一次查询表分区元数据的最大表数量。
HIVE_METADATA_BATCH_SIZE=200
# 数据量查询一次生成 SQL 的最大表数量。
HIVE_COUNT_BATCH_SIZE=200
# 数据量查询同时执行的批次数量，过大可能造成 Hive/YARN 资源竞争。
HIVE_COUNT_CONCURRENCY=4
# 视图源表解析同时处理的视图数量。
VIEW_SOURCE_QUERY_CONCURRENCY=4

# ==================== 可选高级配置 ====================
# HDFS 客户端命令绝对路径；为空时自动尝试 hdfs dfs，再尝试 hadoop fs。
# HDFS_BIN=
# 自定义“读取数据库全部表名”命令；为空时使用内置 Hive 查询。
# HIVE_LIST_TABLES_COMMAND=
# 视图源表本地映射 JSON 文件；为空时使用项目根目录下的 view-source-map.json。
# VIEW_SOURCE_MAP_JSON=
